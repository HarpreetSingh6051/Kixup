# ---- Supabase (leave blank to run on the seeded local demo dataset) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Google Gemini (receipt OCR + AI mechanic). Blank = deterministic demo AI ----
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ---- Cloudflare R2 public bucket for photos / exhaust clips / reels ----
VITE_R2_PUBLIC_BASE_URL=

# ---- App ----
VITE_APP_URL=https://packpulse.app
VITE_DEFAULT_CURRENCY=INR
